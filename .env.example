# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Frontend Client)
# Retrieve these from your Supabase Project Settings -> API.
# Note: Use the PUBLISHABLE / ANON key ONLY in client code.
# NEVER put the service_role key here, as it would be exposed in browser bundles.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# GITHUB PAGES DEPLOYMENT (Optional)
# If deploying to GitHub Pages under a subpath like https://username.github.io/our-universe/
# set this to '/our-universe/' in GitHub Actions or repository environment variables.
VITE_BASE_PATH="/"
